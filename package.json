{
  "name": "rewoven",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "devx": "bun run db:start && bun run dev",
    "db:start": "supabase start && supabase seed buckets --local",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "build": "next build",
    "build:vercel": "bun scripts/vercel-build.ts",
    "start": "next start",
    "lint": "biome check",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests/*.test.ts",
    "db:migrate": "supabase migration up --local",
    "db:seed": "bun --env-file=.env.local scripts/seed-cases.ts",
    "db:seed:production": "bun scripts/seed-cases.ts --production",
    "test:integration": "bun --env-file=.env.local test ./tests/library.integration.ts ./tests/ai-reading.integration.ts ./tests/multi-source.integration.ts ./tests/case-reading.integration.ts",
    "test:ai:live": "bun --env-file=.env.local test ./tests/ai-reading.live.ts",
    "db:backfill": "bun --conditions=react-server --env-file=.env.local scripts/backfill-sources.ts",
    "test:retrieval:live": "bun --conditions=react-server --env-file=.env.local scripts/evaluate-retrieval.ts --live",
    "test:case-reading:live": "bun --env-file=.env.local test ./tests/case-reading.live.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "1.2.15",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.15",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
