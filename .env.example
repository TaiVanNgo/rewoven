SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
# Deployment credentials: set these only in Vercel's Production environment.
# Leave unset in local development and Preview environments.
# SUPABASE_PROJECT_REF=your-production-project-reference
# SUPABASE_ACCESS_TOKEN=your-scoped-deployment-token
# SUPABASE_DB_PASSWORD=your-production-database-password
# Optional: set true only in Vercel Production for a sample import, then unset.
# SEED_SAMPLE_CASES=false
OPENAI_API_KEY=your-api-key
# Optional server-only AI reading settings.
OPENAI_CASE_MODEL=gpt-4.1-mini-2025-04-14
# Limits apply outside development. `bun run dev` has no attempt limits.
# Zero disables new readings in production; successful cache reuse still works.
# A staged multi-document run uses one attempt; retrying a failed run uses another.
AI_CASE_SESSION_LIMIT=50
AI_CASE_DAILY_LIMIT=100
# Optional chat model; defaults to OPENAI_CASE_MODEL when unset.
# OPENAI_CHAT_MODEL=gpt-4.1-mini-2025-04-14
# Chat turns have separate production limits; development has no turn limits.
# A turn uses at most one interpretation call and one answer call.
# Failed/uncertain attempts keep their reservation; retries use another attempt.
AI_CHAT_SESSION_LIMIT=50
AI_CHAT_DAILY_LIMIT=100
# Embedding budgets are separate from AI-reading attempts and apply to queries too.
# Zero pauses new embedding calls. Failed/uncertain calls retain reserved capacity.
EMBEDDING_SESSION_TOKEN_LIMIT=2000000
EMBEDDING_DAILY_TOKEN_LIMIT=10000000
